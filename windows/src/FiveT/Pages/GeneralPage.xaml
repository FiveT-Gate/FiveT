<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FiveT.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer>
        <StackPanel Padding="24,8,24,24" MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">
            <TextBlock Text="General" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <!-- Setup (a page of its own until 1.4.1, as on the Mac): one line when all is well,
                 a Set Up FiveT button when something is missing. -->
            <InfoBar x:Name="SetupBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Checking…"
                     AutomationProperties.AutomationId="SetupBar">
                <InfoBar.ActionButton>
                    <Button x:Name="SetupAction" Style="{StaticResource AccentButtonStyle}" Click="SetupAction_Click"
                            Visibility="Collapsed" AutomationProperties.AutomationId="SetupAction" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="Message" IsClosable="True" Severity="Informational" AutomationProperties.AutomationId="SetupMessage" />
            <tk:SettingsExpander x:Name="ChecksExpander" Header="Requirements" Description="OpenConnect, the tunnel driver and administrator rights"
                                 AutomationProperties.AutomationId="ChecksExpander">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE90F;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.ItemsHeader>
                    <StackPanel x:Name="Checks" Spacing="4" Padding="16,12,16,12" />
                </tk:SettingsExpander.ItemsHeader>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="OpenConnect" x:Name="OpenconnectCard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Choose openconnect.exe…" Click="ChooseOpenconnect_Click" AutomationProperties.AutomationId="ChooseOpenconnect" />
                            <Button Content="Download page" Click="OpenDownloadPage_Click" AutomationProperties.AutomationId="OpenDownloadPage" />
                            <Button Content="Refresh" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshChecks" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <TextBlock Text="Behavior" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <tk:SettingsCard Header="Start FiveT at login" Description="As administrator, without a UAC prompt">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="LoginSwitch" Toggled="LoginSwitch_Toggled" AutomationProperties.AutomationId="LoginSwitch" />
            </tk:SettingsCard>
            <InfoBar x:Name="LoginMessage" IsClosable="False" Severity="Informational" AutomationProperties.AutomationId="LoginMessage" />
            <tk:SettingsCard Header="Reconnect when the connection drops">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72C;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="ReconnectSwitch" Toggled="ReconnectSwitch_Toggled" AutomationProperties.AutomationId="ReconnectSwitch" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Reconnect when the tunnel stops answering" Description="Checks every 20 seconds through the tunnel's DNS server">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D2;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="WatchdogSwitch" Toggled="WatchdogSwitch_Toggled" AutomationProperties.AutomationId="WatchdogSwitch" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Show a notification when a connection changes">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA8F;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="NotifySwitch" Toggled="NotifySwitch_Toggled" AutomationProperties.AutomationId="NotifySwitch" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Install updates automatically" Description="Checks once a day on FiveT's GitHub releases, downloads quietly and installs when no VPN is connected. Only releases signed with FiveT's key are installed. When off, use Updates below.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="UpdateSwitch" Toggled="UpdateSwitch_Toggled" AutomationProperties.AutomationId="UpdateSwitch" />
            </tk:SettingsCard>

            <TextBlock Text="VPN Settings" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <tk:SettingsCard Header="Kill Switch" Description="Blocks internet access if the VPN (OpenVPN, V2Ray or Outline) drops, until it is back or you disconnect it. Not for Forti connections.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="KillSwitchSwitch" Toggled="KillSwitchSwitch_Toggled" AutomationProperties.AutomationId="KillSwitchSwitch" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Use the VPN for Chosen Apps Only" Description="For V2Ray and Outline. Only the apps below use the VPN, and the rest of this PC stays as it is. Start them from FiveT's menu (Open with VPN). While the VPN is down they have no internet at all. Works for apps built on Chrome (Chrome, Edge, Claude, Slack, VS Code…), not for most other programs.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71D;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AppsOnlySwitch" Toggled="AppsOnlySwitch_Toggled" AutomationProperties.AutomationId="AppsOnlySwitch" />
            </tk:SettingsCard>
            <StackPanel x:Name="AppsPanel" Spacing="4" Visibility="Collapsed">
                <StackPanel x:Name="AppsList" Spacing="4" />
                <tk:SettingsCard Header="Add App…" Description="Choose the program's .exe file." Margin="32,0,0,0">
                    <Button Content="Add App…" Click="AddApp_Click" AutomationProperties.AutomationId="AddApp" />
                </tk:SettingsCard>
            </StackPanel>
            <tk:SettingsCard Header="Switch to Another VPN if One Stops Working" Description="If a VPN stays down after a few tries, FiveT connects the next VPN in your list, and keeps going round the list until one works.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8AB;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="FailoverSwitch" Toggled="FailoverSwitch_Toggled" AutomationProperties.AutomationId="FailoverSwitch" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Bypass Iranian Websites" Description="V2Ray and Outline: .ir sites and Iranian addresses skip the server and go direct, also those only Iranian DNS knows.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE909;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="BypassIranSwitch" Toggled="BypassIranSwitch_Toggled" AutomationProperties.AutomationId="BypassIranSwitch" />
            </tk:SettingsCard>

            <TextBlock Text="Backup" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <tk:SettingsCard Header="Export and import settings" Description="A .fivet file holds all connections and settings, with their passwords and one-time-code secrets in plain text, so keep it private. Import it on another PC or on a Mac to copy them.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B5;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Export Settings…" Click="ExportSettings_Click" AutomationProperties.AutomationId="ExportSettings" />
                    <Button Content="Import Settings…" Click="ImportSettings_Click" AutomationProperties.AutomationId="ImportSettings" />
                </StackPanel>
            </tk:SettingsCard>

            <TextBlock Text="Troubleshooting" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <tk:SettingsCard Header="Diagnostics" Description="Setup checks and the recent log, for whoever helps you. Never your passwords.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </tk:SettingsCard.HeaderIcon>
                <Button Content="Copy Diagnostics" Click="CopyDiagnostics_Click" AutomationProperties.AutomationId="CopyDiagnostics" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="LogFileCard" Header="Log">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C3;" />
                </tk:SettingsCard.HeaderIcon>
                <Button Content="Open Log" Click="OpenLog_Click" AutomationProperties.AutomationId="OpenLog" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Verbose openconnect logging">
                <ToggleSwitch x:Name="VerboseSwitch" Toggled="VerboseSwitch_Toggled" AutomationProperties.AutomationId="VerboseSwitch" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="PacketsCard" Header="Keep per-packet traces (thousands of lines per minute)" Margin="32,0,0,0">
                <ToggleSwitch x:Name="PacketsSwitch" Toggled="PacketsSwitch_Toggled" AutomationProperties.AutomationId="PacketsSwitch" />
            </tk:SettingsCard>
            <tk:SettingsCard x:Name="ConnectionsFileCard" Header="Connections file">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <TextBlock Text="About" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <tk:SettingsCard x:Name="UpdateCard" Header="Updates" Description="Not checked yet." AutomationProperties.AutomationId="UpdateCard">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="InstallUpdateButton" Content="Install and Restart" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="InstallUpdate_Click" AutomationProperties.AutomationId="InstallUpdate" />
                    <Button x:Name="CheckUpdateButton" Content="Check Now" Click="CheckUpdate_Click" AutomationProperties.AutomationId="CheckUpdate" />
                </StackPanel>
            </tk:SettingsCard>
            <TextBlock x:Name="AboutText" Style="{StaticResource SettingsCaptionStyle}" Margin="1,0,0,0" />
            <HyperlinkButton Content="FiveT on GitHub" NavigateUri="https://github.com/FiveT-Gate/FiveT" AutomationProperties.AutomationId="GitHubLink" />
        </StackPanel>
    </ScrollViewer>
</Page>
