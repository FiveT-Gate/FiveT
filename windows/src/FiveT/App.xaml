<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FiveT.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Connection state dots (same colours as the macOS app). -->
            <SolidColorBrush x:Key="StateConnectedBrush" Color="#34C759" />
            <SolidColorBrush x:Key="StateBusyBrush" Color="#FF9500" />
            <SolidColorBrush x:Key="StateIdleBrush" Color="#B4B4B4" />
            <x:Double x:Key="SettingsFieldWidth">300</x:Double>
            <!-- A masked field with its Show… button beside it takes the same width as a plain field. -->
            <x:Double x:Key="SecretFieldWidth">212</x:Double>
            <!-- Flyout rows look like menu items: flat, full width, subtle hover. These live here rather
                 than in TrayFlyout.xaml because a framework key such as DefaultButtonStyle only resolves
                 where XamlControlsResources is merged; from a page's own resource block the Release XAML
                 compiler fails the whole page with "XAML parsing failed" while Debug still loads it. -->
            <Style x:Key="FlyoutRowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,7,10,7" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="FlyoutSeparatorStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="4,4,4,4" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,6" />
            </Style>
            <Style x:Key="SettingsCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="1,6,0,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
